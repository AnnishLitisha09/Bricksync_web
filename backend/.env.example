# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (For Docker container accessing Windows MySQL, use host.docker.internal)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=bricksync
DB_POOL_MAX=25
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
CRYPTO_SECRET=your_crypto_secret_here
QR_SECRET=your_qr_secret_here
STRICT_SIGNATURE=false
MAX_CONCURRENT_REQUESTS=100

# Frontend URL (Vercel deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app

# Email & Notifications (Optional / If configured)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# AI / Integrations (Optional)
GROQ_API_KEY=your_groq_api_key_here
